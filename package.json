{
  "name": "@gg-utils/platform-orchestration-kit",
  "version": "0.2.0",
  "description": "Reusable platform orchestration command catalog, diagnostics, and UI launcher helpers.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./command-catalog": {
      "types": "./dist/command-catalog.d.ts",
      "default": "./dist/command-catalog.js"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "default": "./dist/diagnostics.js"
    },
    "./format-command": {
      "types": "./dist/format-command.d.ts",
      "default": "./dist/format-command.js"
    },
    "./interactive-menu": {
      "types": "./dist/interactive-menu.d.ts",
      "default": "./dist/interactive-menu.js"
    },
    "./maintainer-argv": {
      "types": "./dist/maintainer-argv.d.ts",
      "default": "./dist/maintainer-argv.js"
    },
    "./package-orchestration": {
      "types": "./dist/package-orchestration.d.ts",
      "default": "./dist/package-orchestration.js"
    },
    "./npm-spawn": {
      "types": "./dist/npm-spawn.d.ts",
      "default": "./dist/npm-spawn.js"
    },
    "./screen-state": {
      "types": "./dist/screen-state.d.ts",
      "default": "./dist/screen-state.js"
    },
    "./spawn-npx-tsx": {
      "types": "./dist/spawn-npx-tsx.d.ts",
      "default": "./dist/spawn-npx-tsx.js"
    },
    "./ui-launcher": {
      "types": "./dist/ui-launcher.d.ts",
      "default": "./dist/ui-launcher.js"
    },
    "./opentui-app": {
      "types": "./dist/opentui-app.d.ts",
      "default": "./dist/opentui-app.js"
    },
    "./ink-app": {
      "types": "./dist/ink-app.d.ts",
      "default": "./dist/ink-app.js"
    },
    "./package.json": "./package.json",
    "./install-report": {
      "types": "./dist/install-report.d.ts",
      "default": "./dist/install-report.js"
    },
    "./maintainer-ink-app": {
      "types": "./dist/maintainer-ink-app.d.ts",
      "default": "./dist/maintainer-ink-app.js"
    },
    "./maintainer-opentui-app": {
      "types": "./dist/maintainer-opentui-app.d.ts",
      "default": "./dist/maintainer-opentui-app.js"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0 <27",
    "npm": ">=9.0.0"
  },
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/**/*.unit.test.js\"",
    "lint": "eslint --max-warnings 0 .",
    "check:dist": "sh scripts/check-dist.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gg-utils/platform-orchestration-kit.git"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "dependencies": {
    "ink": "^6.8.0",
    "react": "^19.2.0",
    "react-router": "^7.18.5"
  }
}
